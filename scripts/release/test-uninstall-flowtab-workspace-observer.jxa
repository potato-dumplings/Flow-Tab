ObjC.import("AppKit");

const workspaceEventDeliveryWatchdogSeconds = 5;

function fail(message) {
  throw new Error(`FAIL: ${message}`);
}

function readSource(path) {
  const error = $();
  const source = $.NSString.stringWithContentsOfFileEncodingError(
    path,
    $.NSUTF8StringEncoding,
    error
  );
  if (source.isNil()) {
    fail(`unable to read uninstaller source: ${error.localizedDescription.js}`);
  }
  return ObjC.unwrap(source);
}

function loadUninstaller(sourcePath) {
  const source = readSource(sourcePath);
  return new Function(`
    ${source}
    return {
      startWorkspaceApplicationExitObservation,
      waitForWorkspaceApplicationExit,
    };
  `)();
}

function run(arguments) {
  if (arguments.length !== 3) {
    fail("expected uninstaller source, fixture app, and fixture bundle identifier");
  }

  const sourcePath = arguments[0];
  const fixturePath = arguments[1];
  const fixtureBundleIdentifier = arguments[2];
  const uninstaller = loadUninstaller(sourcePath);
  const workspace = $.NSWorkspace.sharedWorkspace;
  const launchError = $();
  const runningApplication = workspace
    .launchApplicationAtURLOptionsConfigurationError(
      $.NSURL.fileURLWithPath(fixturePath),
      $.NSWorkspaceLaunchNewInstance,
      $.NSDictionary.dictionary,
      launchError
    );
  if (runningApplication.isNil()) {
    fail(`unable to launch fixture: ${launchError.localizedDescription.js}`);
  }

  let observation = null;
  try {
    const actualBundleIdentifier = ObjC.unwrap(
      runningApplication.bundleIdentifier
    );
    if (actualBundleIdentifier !== fixtureBundleIdentifier) {
      fail(`unexpected fixture bundle identifier: ${actualBundleIdentifier}`);
    }

    observation = uninstaller.startWorkspaceApplicationExitObservation(
      fixtureBundleIdentifier
    );
    const processIdentifier = Number(runningApplication.processIdentifier);
    if (
      !observation.initialEvidence.activeApplications.some(
        (record) => record.includes(`pid=${processIdentifier}`)
      )
    ) {
      fail("initial readback did not contain the exact fixture process");
    }

    const terminationStartedAt = Number(
      $.NSProcessInfo.processInfo.systemUptime
    );
    if (!runningApplication.forceTerminate) {
      fail("fixture termination request was rejected");
    }
    uninstaller.waitForWorkspaceApplicationExit(observation);
    const terminationElapsed = Number(
      $.NSProcessInfo.processInfo.systemUptime
    ) - terminationStartedAt;

    if (observation.state.generation !== 1) {
      fail(`expected one exact termination generation, got ${observation.state.generation}`);
    }
    if (terminationElapsed >= workspaceEventDeliveryWatchdogSeconds) {
      fail(`workspace notification did not wake the wait owner: ${terminationElapsed}s`);
    }
    if (!observation.state.lastNotification.includes(`pid=${processIdentifier}`)) {
      fail("termination notification did not preserve the fixture process identity");
    }
  } finally {
    if (observation) {
      observation.cancel();
    }
    if (!runningApplication.terminated) {
      runningApplication.forceTerminate;
    }
  }

  if (!observation.state.cancelled) {
    fail("workspace observation owner did not cancel its observer");
  }
  return "Uninstaller observed exact workspace termination and final absence readback.";
}
